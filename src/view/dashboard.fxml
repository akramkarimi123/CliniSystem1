<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controller.DashboardController">
    
    <top>
        <VBox>
            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15 20;">
                <Label text="Karimi Dental Clinic" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0066a0;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="welcomeLabel" text="Welcome"/>
                <Label fx:id="roleLabel" text="Role"/>
                <Button text="Refresh" onAction="#refresh"/>
                <Button text="Logout" onAction="#logout"/>
            </HBox>
            <MenuBar>
                <Menu text="File">
                    <MenuItem text="Logout" onAction="#logout"/>
                    <MenuItem text="Exit" onAction="#exit"/>
                </Menu>
                <Menu text="Management">
                    <MenuItem text="Patients" onAction="#showPatients"/>
                    <MenuItem text="Appointments" onAction="#showAppointments"/>
                    <MenuItem text="Treatments" onAction="#showTreatments"/>
                    <MenuItem text="Billing" onAction="#showBilling"/>
                </Menu>
            </MenuBar>
        </VBox>
    </top>
    
    <center>
        <BorderPane fx:id="mainContent">
            
            <!-- TOP STATS -->
            <top>
                <VBox spacing="15" style="-fx-padding: 20;">
                    <HBox spacing="20" alignment="CENTER">
                        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-alignment: center;">
                            <Label text="Today's Appointments"/>
                            <Label fx:id="todayAppointmentsLabel" text="0"/>
                        </VBox>
                        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-alignment: center;">
                            <Label text="Pending Payments"/>
                            <Label fx:id="pendingPaymentsLabel" text="0"/>
                        </VBox>
                        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-alignment: center;">
                            <Label text="Total Patients"/>
                            <Label fx:id="totalPatientsLabel" text="0"/>
                        </VBox>
                        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-alignment: center;">
                            <Label text="Total Revenue"/>
                            <Label fx:id="totalRevenueLabel" text="\$0.00"/>
                        </VBox>
                    </HBox>

                    <Separator/>

                    <HBox spacing="15" alignment="CENTER">
                        <Button text="Patient Management" onAction="#showPatients"/>
                        <Button text="Appointment Management" onAction="#showAppointments"/>
                        <Button text="Treatment Catalog" onAction="#showTreatments"/>
                        <Button text="Billing and Invoices" onAction="#showBilling"/>
                    </HBox>
                </VBox>
            </top>

            <!-- CHARTS SECTION -->
            <center>
                <VBox spacing="20" style="-fx-padding: 20;">
                    
                    <Label text="Clinic Analytics" 
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0066a0;"/>

                    <HBox spacing="20" alignment="CENTER">
                        
                        <!-- Bar Chart -->
                        <BarChart fx:id="appointmentsChart" prefWidth="500" prefHeight="300">
                            <xAxis>
                                <CategoryAxis label="Day"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Appointments"/>
                            </yAxis>
                        </BarChart>

                        <!-- Pie Chart -->
                        <PieChart fx:id="paymentChart" prefWidth="400" prefHeight="300"/>
                        
                    </HBox>

                </VBox>
            </center>

        </BorderPane>
    </center>
</BorderPane>