<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controller.LoginController"
      styleClass="login-container" stylesheets="@dental_clinic.css">
    
    <VBox alignment="CENTER" spacing="10">
        <Text styleClass="login-title" text="KARIMI DENTAL CLINIC"/>
        <Text styleClass="login-subtitle" text="Clinic Management System"/>
        
        <Separator prefWidth="300"/>
        
        <TextField fx:id="usernameField" promptText="Username" styleClass="login-field"/>
        <PasswordField fx:id="passwordField" promptText="Password" styleClass="login-field"/>
        
        <HBox spacing="15" alignment="CENTER">
            <Button fx:id="loginButton" text="LOGIN" styleClass="login-button" onAction="#login"/>
            <Button fx:id="cancelButton" text="CANCEL" styleClass="login-button" onAction="#cancel"/>
        </HBox>
        
        <Label fx:id="statusLabel" styleClass="status-label"/>
    </VBox>
</VBox>